# Copy this file to ".env" (same folder as manage.py) before running the server.
# DEBUG=True is required locally, otherwise the admin page loads without CSS/JS.
SECRET_KEY=replace-this-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# Leave empty to use SQLite, or e.g. postgres://user:password@localhost:5432/workorders
DATABASE_URL=
